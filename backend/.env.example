[TEMPLATE]
# Supabase Configuration (get from Supabase Dashboard -> Settings -> API)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# OCR Provider: 'cloud' -> OCR.space API (fast, zero local model memory)
OCR_PROVIDER=cloud

# OCR.space API key (Get a free key at https://ocr.space/ocrapi/freekey)
OCR_API_KEY=

# Groq AI API Key (Optional for Llama 3 70B AI label analysis)
GROQ_API_KEY=

# Backend Configuration
BACKEND_URL=http://localhost:8000
DEBUG=true
