[TEMPLATE]
# Supabase Configuration (get from Supabase Dashboard -> Settings -> API)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# OCR Provider
# 'local' -> EasyOCR (free, runs on your machine, supports en+hi)
# 'cloud' -> OCR.space API (fast, no local model needed)
OCR_PROVIDER=local

# OCR.space API key (only required when OCR_PROVIDER=cloud)
# Get a free key at https://ocr.space/ocrapi/freekey
OCR_API_KEY=

# Backend Configuration
BACKEND_URL=http://localhost:8000
DEBUG=true
